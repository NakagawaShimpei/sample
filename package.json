{
  "name": "sample-we-project",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "concurrently -k -n API,APP -c blue,green \"npm:start:api\" \"npm:start:app\"",
    "start:api": "npm run dev --prefix backend",
    "start:app": "npm run dev --prefix frontend",
    "build": "npm run build --prefix frontend",
    "install:all": "npm install && npm install --prefix frontend && npm install --prefix backend"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
